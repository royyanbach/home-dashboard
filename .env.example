# Clips API — paginated list of recordings
VITE_CLIPS_API_URL=https://home-automation-clips-api.example.workers.dev

# Media host — base URL for video and thumbnail files (no trailing slash)
VITE_CLIPS_HOST=https://media.example.com

# Live camera host — base URL for stream + snapshot (no trailing slash)
# Serves {VITE_CAMERA_ID}-live and {VITE_CAMERA_ID}-snapshot
VITE_LIVE_HOST=https://live.example.com

# Camera slug used for live stream / snapshot paths (default: cam1)
# VITE_CAMERA_ID=cam1

# Build commit hash shown in Settings; GitHub Actions sets this automatically
# VITE_BUILD_COMMIT_SHA=local
